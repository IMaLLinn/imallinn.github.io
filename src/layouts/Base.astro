---
import { ClientRouter } from 'astro:transitions';
import Command from '../components/Command.astro';
import Icon from '../components/Icon.astro';
import { site } from '../config/site';
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/site.css';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}
const { title, description = site.description, type = 'website', noindex = false } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : site.name;
const canonical = new URL(Astro.url.pathname, site.url);
const current = (url: string) => url === '/' ? Astro.url.pathname === url : Astro.url.pathname.startsWith(url);
---
<!doctype html>
<html lang={site.locale} class:list={{ dark: site.defaultTheme === 'dark' }} data-default-theme={site.defaultTheme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={site.name} href={site.rss} />
    <script is:inline>
      (() => {
        const root = document.documentElement;
        let theme = root.dataset.defaultTheme;
        try {
          const saved = localStorage.getItem('jude-theme');
          if (saved === 'light' || saved === 'dark') theme = saved;
        } catch {}
        root.classList.toggle('dark', theme === 'dark');
      })();
    </script>
    <ClientRouter />
    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="skip-link">跳至正文</a>
    <header class="topbar">
      <div class="site-width topbar-inner">
        <a class="brand" href="/" aria-label={site.name + '首页'}>{site.name}</a>
        <nav class="nav-pill" aria-label="主导航" transition:persist="primary-nav">
          <span class="nav-indicator" aria-hidden="true"></span>
          {site.nav.map(({ label, href }) => <a href={href} class:list={{ current: current(href) }} aria-current={current(href) ? 'page' : undefined}>{label}</a>)}
        </nav>
        <div class="nav-actions">
          <button type="button" class="nav-search" aria-label="打开命令面板" data-command-open><Icon name="search" size={17} /><kbd class="mono" aria-hidden="true"><span data-modifier>Ctrl</span><span>K</span></kbd></button>
          <button type="button" class="theme-toggle" aria-label="切换浅色或暗黑主题" data-theme-toggle>
            <span class="icon-moon"><Icon name="moon" size={17} /></span><span class="icon-sun"><Icon name="sun" size={17} /></span>
          </button>
        </div>
      </div>
    </header>
    <main id="main" class="site-width"><slot /></main>
    <footer class="site-width site-footer">
      <span><b>{site.name}</b><span class="footer-divider"></span>个人技术笔记</span>
      <div><a href={site.github} target="_blank" rel="noopener">GitHub <Icon name="arrow-up-right" size={13} /></a><a href={site.rss}>RSS <Icon name="rss" size={13} /></a></div>
    </footer>
    <Command />
    <div class="toast" role="status" aria-live="polite" data-toast></div>
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
