---
import { site } from '../config/site';
const { to } = Astro.props as { to: string };
---
<!doctype html>
<html lang={site.locale}>
  <head>
    <meta charset="utf-8" />
    <title>页面已迁移 · {site.name}</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={new URL(to, site.url)} />
    <meta http-equiv="refresh" content={`0;url=${to}`} />
  </head>
  <body>
    <p><a href={to} data-legacy-target>打开新页面</a></p>
    <script is:inline>
      const next = new URL(document.querySelector('[data-legacy-target]').href);
      for (const [key, value] of new URLSearchParams(location.search)) {
        if (!next.searchParams.has(key)) next.searchParams.set(key, value);
      }
      location.replace(next.href + location.hash);
    </script>
  </body>
</html>
