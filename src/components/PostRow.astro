---
import type { Post } from '../lib/posts';
import { dateOf, postHref, titleOf } from '../lib/posts';
import Icon from './Icon.astro';

const { post, showArchived = false } = Astro.props as { post: Post; showArchived?: boolean };
const category = post.data.categories[0];
---
<a class="post-row" href={postHref(post)}>
  <span class="post-row-icon"><Icon name="file-text" size={16} /></span>
  <span class="post-row-title">{titleOf(post)}</span>
  {showArchived && post.data.archived && <span class="archive-badge">归档</span>}
  {category && <span class="category-pill">{category}</span>}
  <time class="mono" datetime={dateOf(post)}>{dateOf(post)}</time>
</a>
