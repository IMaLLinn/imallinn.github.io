---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import PostRow from '../../components/PostRow.astro';
import { filters, filterValues, publishedPosts, type Filter, type Post } from '../../lib/posts';

const posts = await publishedPosts();
const active = posts.filter(({ data }) => !data.archived);
const archivedCount = posts.length - active.length;
const labels: Record<Filter, string> = { series: '专题', category: '分类', tag: '标签' };
const values = (scope: Post[], filter: Filter) => new Set(scope.flatMap((post) => filterValues(post, filter)));
const facets = filters.map((filter) => {
  const activeValues = values(active, filter);
  const options = [...values(posts, filter)].sort((a, b) => a.localeCompare(b, 'zh-CN'));
  return { filter, activeValues, options };
});
const tagFacet = facets.find(({ filter }) => filter === 'tag')!;
---
<Base title="文章">
  <div class="inner-page" data-post-list>
    <header class="page-heading"><span class="section-icon"><Icon name="file-text" /></span><h1>文章</h1><p>技术笔记、课程实验与项目记录。</p></header>
    <section class="surface filter-panel" aria-label="文章筛选">
      {facets.filter(({ filter }) => filter !== 'tag').map(({ filter, activeValues, options }) => (
        <div class="facet">
          <span id={'label-' + filter}>{labels[filter]}</span>
          <div class="facet-options" role="group" aria-labelledby={'label-' + filter}>
            <button type="button" class="tag" data-filter={filter} data-value="" aria-pressed="true">全部</button>
            {options.map((value) => <button type="button" class="tag" data-filter={filter} data-value={value} data-archived-only={activeValues.has(value) ? undefined : ''} hidden={!activeValues.has(value)} aria-pressed="false">{value}</button>)}
          </div>
        </div>
      ))}
      <details class="tag-facet" data-tag-facet>
        <summary class="soft-button"><span data-tag-label>按标签筛选 ({tagFacet.activeValues.size})</span><Icon name="chevron-down" size={14} /></summary>
        <div class="facet-options" role="group" aria-label="标签">
          <button type="button" class="tag" data-filter="tag" data-value="" aria-pressed="true">全部</button>
          {tagFacet.options.map((value) => <button type="button" class="tag" data-filter="tag" data-value={value} data-archived-only={tagFacet.activeValues.has(value) ? undefined : ''} hidden={!tagFacet.activeValues.has(value)} aria-pressed="false">{value}</button>)}
        </div>
      </details>
    </section>
    <section class="surface list-panel" aria-label="文章列表">
      <div class="list-toolbar">
        <span class="list-meta" data-filter-status aria-live="polite">共 {active.length} 篇文章</span>
        {archivedCount > 0 && <button type="button" class="soft-button archive-toggle" data-archive-toggle aria-pressed="false">显示早期归档 (+{archivedCount})</button>}
      </div>
      <ul>{posts.map((post) => (
        <li data-post-facets={JSON.stringify(filters.map((filter) => filterValues(post, filter)))} data-archived={post.data.archived ? '' : undefined} hidden={post.data.archived}>
          <PostRow post={post} showArchived />
        </li>
      ))}</ul>
    </section>
  </div>
  <script>
    const keys = ['series', 'category', 'tag'] as const;

    document.addEventListener('astro:page-load', () => {
      const page = document.querySelector<HTMLElement>('[data-post-list]');
      if (!page) return;
      const controls = [...page.querySelectorAll<HTMLButtonElement>('[data-filter]')];
      const rows = [...page.querySelectorAll<HTMLElement>('[data-post-facets]')].map((row) => ({
        row,
        archived: row.hasAttribute('data-archived'),
        facets: JSON.parse(row.dataset.postFacets!) as string[][],
      }));
      const status = page.querySelector<HTMLElement>('[data-filter-status]')!;
      const archiveToggle = page.querySelector<HTMLButtonElement>('[data-archive-toggle]');
      const tagFacet = page.querySelector<HTMLDetailsElement>('[data-tag-facet]')!;
      const tagLabel = page.querySelector<HTMLElement>('[data-tag-label]')!;

      function apply(query: URLSearchParams) {
        const includeArchived = query.get('archived') === '1';
        archiveToggle?.setAttribute('aria-pressed', String(includeArchived));
        for (const control of controls) {
          control.hidden = control.hasAttribute('data-archived-only') && !includeArchived;
          control.setAttribute('aria-pressed', String(!control.hidden && (query.get(control.dataset.filter!) ?? '') === control.dataset.value));
        }

        const tags = controls.filter((control) => control.dataset.filter === 'tag' && control.dataset.value && !control.hidden);
        const selectedTag = tags.find((tag) => tag.getAttribute('aria-pressed') === 'true');
        tagLabel.textContent = selectedTag ? '标签：' + selectedTag.dataset.value : '按标签筛选 (' + tags.length + ')';

        const selected = keys.map((key) => query.get(key));
        let count = 0;
        for (const { row, archived, facets } of rows) {
          const matches = (includeArchived || !archived) && selected.every((value, index) => !value || facets[index].includes(value));
          row.hidden = !matches;
          if (matches) count++;
        }
        status.textContent = count ? '共 ' + count + ' 篇文章' : '没有符合条件的文章。';
      }

      function update(next: URL) {
        history.replaceState(history.state, '', next);
        apply(next.searchParams);
      }

      page.onclick = (event) => {
        const button = (event.target as Element).closest<HTMLButtonElement>('button');
        if (!button) return;
        const next = new URL(location.href);
        if (button === archiveToggle) {
          if (next.searchParams.get('archived') === '1') {
            next.searchParams.delete('archived');
            for (const { dataset } of controls.filter((control) => control.hasAttribute('data-archived-only'))) {
              if (next.searchParams.get(dataset.filter!) === dataset.value) next.searchParams.delete(dataset.filter!);
            }
          } else {
            next.searchParams.set('archived', '1');
          }
        } else {
          const { filter, value } = button.dataset;
          if (!filter) return;
          if (value) next.searchParams.set(filter, value);
          else next.searchParams.delete(filter);
        }
        update(next);
      };

      const query = new URLSearchParams(location.search);
      tagFacet.open = Boolean(query.get('tag'));
      apply(query);
    });
  </script>
</Base>
