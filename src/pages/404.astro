---
import Base from '../layouts/Base.astro';
---
<Base title="页面未找到" noindex>
  <div class="inner-page">
    <section class="surface about-panel">
      <h1>页面未找到</h1>
      <p class="about-description">可以从文章列表查找笔记，或打开命令面板搜索。</p>
      <div class="hero-actions">
        <a href="/posts/" class="soft-button">全部文章</a>
        <button type="button" class="soft-button" data-command-open>搜索</button>
      </div>
    </section>
  </div>
</Base>
